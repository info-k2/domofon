# Что отдаём приложению после входа (MediaMTX, не камера)
STREAM_URL=rtsp://192.168.0.34:8554/door

# Вход приложения (HTTP)
API_KEY=
BRIDGE_USER=admin
BRIDGE_PASSWORD=change-me
