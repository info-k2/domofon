# MediaMTX — камера только на сервере.
# Реальный source берётся из docker/mediamtx.yml (не в git, см. .env CAMERA_RTSP).

logLevel: info

rtsp: true
rtspTransports: [tcp]
rtspAddress: :8554

rtmp: false
hls: false
webrtc: false
srt: false
api: false
metrics: false

paths:
  door:
    source: rtsp://USER:PASSWORD@192.168.0.130:554/live/ch01_00
    rtspTransport: tcp
    sourceOnDemand: true
    sourceOnDemandStartTimeout: 10s
