# MediaMTX — RTSP-ретранслятор камеры.
# Скопируйте в mediamtx.yml и подставьте камеру.

logLevel: info

rtsp: true
rtspTransports: [tcp]
rtspAddress: :8554

rtmp: false
hls: false
srt: false
webrtc: false
api: false
metrics: false

paths:
  door:
    source: rtsp://USER:PASSWORD@192.168.0.130:554/live/ch01_00
    rtspTransport: tcp
    sourceOnDemand: false
